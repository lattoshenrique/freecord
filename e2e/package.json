{
  "name": "@freecord/e2e",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "End-to-end and load tests for the Freecord signaling edge and web app",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:protocol": "playwright test --project=protocol",
    "test:browser": "playwright test --project=browser",
    "test:heavy": "E2E_HEAVY=1 playwright test --project=browser --grep @heavy",
    "load:signaling": "node load/signaling.mjs",
    "load:ramp": "node load/ramp.mjs",
    "check:worker": "node worker/screen-drop.mjs",
    "check:ghosts": "node worker/ghost-sweep.mjs"
  },
  "devDependencies": {
    "@freecord/server": "*",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "ws": "^8.18.1"
  }
}
