{
  "name": "freecord",
  "private": true,
  "version": "0.1.1",
  "description": "Guest-first rooms with voice, video, chat and screen sharing",
  "workspaces": [
    "server",
    "web",
    "worker",
    "relay"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "deploy": "npm run build && npm run deploy --workspace worker",
    "dev:desktop": "npm --prefix desktop run dev",
    "dist:desktop": "npm --prefix desktop run dist",
    "typecheck:desktop": "npm --prefix desktop run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
