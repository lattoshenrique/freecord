{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "freecord",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Static files from the web build. The assets layer answers FIRST: the Worker
  // only runs for what does not match a file (API, WS and the SPA fallback for
  // /r/:slug).
  //
  // Do not set `run_worker_first` here without checking what it breaks:
  // robots.txt, sitemap.xml, llms.txt and og.png are real files served by this
  // layer, and flipping the order sends all of them through the SPA fallback,
  // which answers index.html with a 200 — a silent break, not an error.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },

  // Uma Durable Object por sala: o estado vive junto do slug.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }
  ],

  // Mesmo limite do Fastify: 60 criações de sala por minuto por IP.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  }
}
