{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "freecord",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Static files from the web build. The assets layer answers FIRST: the Worker
  // only runs for what does not match a file (API, WS and the SPA fallback for
  // /r/:slug).
  //
  // Do not set `run_worker_first` here without checking what it breaks:
  // robots.txt, sitemap.xml, llms.txt and og.png are real files served by this
  // layer, and flipping the order sends all of them through the SPA fallback,
  // which answers index.html with a 200 — a silent break, not an error.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },

  // One Durable Object per room: the state lives next to the slug. Plus a
  // single STATS object — the counter of rooms that happened, one integer
  // for the whole product (see StatsDurableObject).
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "STATS", "class_name": "StatsDurableObject" }
    ]
  },
  // A migration is applied on deploy and does not undo cleanly: rolling back
  // to a tag that predates v2 is not a plain revert (the class it binds no
  // longer exists in the code being deployed). Worth knowing before the
  // release that carries it.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsDurableObject"] }
  ],

  // Mesmo limite do Fastify: 60 criações de sala por minuto por IP.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  }
}
