{
  "name": "@freecord/desktop",
  "private": true,
  "version": "0.9.0",
  "description": "Freecord desktop app (Electron)",
  "homepage": "https://freecord.lattoshenrique.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lattoshenrique/freecord.git"
  },
  "main": "dist/main.js",
  "author": {
    "name": "Henrique Brito",
    "email": "lattoshenrique@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && FREECORD_URL=http://localhost:5173 electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "icons": "electron build/make-icons.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "electron@44.1.0": true
  },
  "build": {
    "appId": "com.lattoshenrique.freecord",
    "toolsets": {
      "nsis": "1.2.1"
    },
    "productName": "Freecord",
    "copyright": "Copyright (c) 2026 Henrique Brito",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "afterPack": "build/after-pack.cjs",
    "protocols": [
      {
        "name": "Freecord room link",
        "role": "Viewer",
        "schemes": [
          "freecord"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "artifactName": "freecord-mac-${arch}.dmg",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Freecord uses the microphone so you can talk in rooms.",
        "NSCameraUsageDescription": "Freecord uses the camera when you turn video on in a room.",
        "NSScreenCaptureUsageDescription": "Freecord captures the screen when you share it in a room."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png",
      "artifactName": "freecord-win-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Freecord"
    },
    "linux": {
      "executableName": "freecord",
      "icon": "build/icon-win.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "synopsis": "Voice, video and screen sharing rooms with no signup",
      "desktop": {
        "entry": {
          "Name": "Freecord"
        }
      }
    },
    "appImage": {
      "artifactName": "freecord-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "freecord-linux-amd64.deb"
    }
  }
}
